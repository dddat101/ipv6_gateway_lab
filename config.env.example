# ==============================================================================
# NETWORK TEST LAB - IPV6 GATEWAY CONFIGURATION
# ==============================================================================
# Copy this file to config.env and customize for your environment.
# All string values containing spaces, colons, or flags MUST be quoted with double quotes.

# ------------------------------------------------------------------------------
# 1. Topology & Role Selection
# ------------------------------------------------------------------------------
# LAB_ROLE options:
#   'single':  1 PC with 2 dedicated NICs connected to DUT WAN and LAN (Recommended)
#   'wan':     PC1 acts as WAN Server / Gateway Emulator / Controller
#   'lan':     PC2 acts as LAN Client / Performance Peer
LAB_ROLE="single"

# TOPOLOGY_MODE options:
#   'physical': Uses physical Ethernet adapters connected to the real DUT
#   'virtual':  Simulates DUT and datapath via Linux netns (ns-dut) without hardware
TOPOLOGY_MODE="physical"

# ------------------------------------------------------------------------------
# 2. Physical Interfaces (MUST NOT carry host default route)
# ------------------------------------------------------------------------------
# In 'single' mode, specify both adapters:
WAN_IF="enxd46e0e0c65e1"
LAN_IF="enx00e04c88293c"

# In 2-PC mode ('wan' or 'lan'), specify the test adapter connected to the DUT:
DUT_IF="enxd46e0e0c65e1"

# ------------------------------------------------------------------------------
# 3. Linux Bridge & Network Namespace Names
# ------------------------------------------------------------------------------
WAN_BRIDGE="br-test-wan"
LAN_BRIDGE="br-test-lan"
NS_WAN="ns-wan"
NS_LAN="ns-lan1"
NS_DUT="ns-dut"
NS_IF="eth0"

# ------------------------------------------------------------------------------
# 4. Upstream WAN IPv4 Parameters (DHCPv4 Server / Gateway)
# ------------------------------------------------------------------------------
WAN_IPV4_CIDR="10.10.0.1/24"
WAN_IPV4_SUBNET="10.10.0.0/24"
WAN_IPV4_POOL_START="10.10.0.100"
WAN_IPV4_POOL_END="10.10.0.200"
WAN_IPV4_ROUTER="10.10.0.1"
WAN_IPV4_DNS="10.10.0.1"

# ------------------------------------------------------------------------------
# 5. Upstream WAN IPv6 Parameters (SLAAC / DHCPv6 Server)
# ------------------------------------------------------------------------------
WAN_IPV6_CIDR="2001:db8:10::1/64"
WAN_IPV6_PREFIX="2001:db8:10::/64"
WAN_IPV6_DNS="2001:db8:10::1"

# Prefix Delegation (DHCPv6-PD - RFC 3633)
PD_PREFIX="2001:db8:100::"
PD_PREFIX_LEN="56"
PD_DELEGATED_LEN="60"

# ------------------------------------------------------------------------------
# 6. DS-Lite (Dual-Stack Lite - RFC 6333) & AFTR Parameters
# ------------------------------------------------------------------------------
AFTR_IPV6="2001:db8:10::affe"
AFTR_NAME="aftr.example.com"

# ------------------------------------------------------------------------------
# 7. LAN Subnet & Client Defaults
# ------------------------------------------------------------------------------
DUT_LAN_IP="192.168.1.1"
DUT_LAN_IPV6="2001:db8:100::1"
LAN_IPV4_SUBNET="192.168.1.0/24"
LAN_IPV6_PREFIX="2001:db8:100::/64"
LAN_CLIENT_IPV4="192.168.1.100"
LAN_CLIENT_IPV6="2001:db8:100::100"
LAN_CLIENT_HOSTNAME="ipv6-stb-client"
LAN_CLIENT_VENDOR="IPTV_STB"

# ------------------------------------------------------------------------------
# 8. Router Advertisement (RA) Timers (RFC 4861 / RFC 8106)
# ------------------------------------------------------------------------------
RA_MIN_INTERVAL_SEC="3"
RA_MAX_INTERVAL_SEC="10"
RA_LIFETIME_SEC="60"

# ------------------------------------------------------------------------------
# 9. DHCP Lifetimes
# ------------------------------------------------------------------------------
DHCP_VALID_LIFETIME_SEC="600"
DHCP_RENEW_TIMER_SEC="300"
DHCP_REBIND_TIMER_SEC="450"
DHCP6_PREFERRED_LIFETIME_SEC="450"

# ------------------------------------------------------------------------------
# 10. Test Scenarios & Execution Parameters
# ------------------------------------------------------------------------------
# Scenarios:
#   'dual-stack':        Concurrent IPv4 NAT + IPv6 SLAAC/DHCPv6 (Baseline)
#   'slaac':             Stateless Address Autoconfiguration + RDNSS
#   'stateful-v6':       Stateful DHCPv6 (IA_NA + IA_PD)
#   'stateless-v6':      SLAAC + Stateless DHCPv6 Information-Request
#   'ipv4-only':         IPv4-only WAN (IPv6 disabled on internal LAN)
#   'ipv6-only-dslite':  IPv6-only WAN with DS-Lite AFTR tunnel + Multicast DHCPv4
DEFAULT_SCENARIO="dual-stack"

PING_COUNT="5"
PING_TIMEOUT_SEC="2"
IPERF_DURATION_SEC="10"
IPERF_PARALLEL="4"

# ------------------------------------------------------------------------------
# 11. Packet Capture, Runtime & Tool Paths
# ------------------------------------------------------------------------------
CAPTURE_DIR="captures"
STATE_DIR="state"
LOG_DIR="logs"
CAPTURE_SNAPLEN="0"
CAPTURE_FILTER="icmp6 or (udp port 546 or udp port 547) or (udp port 67 or udp port 68) or (ip6 proto 4) or icmp"

TCPDUMP_BIN="tcpdump"
TSHARK_BIN="tshark"
PYTHON_BIN=""               # Auto-detects .venv/bin/python3 if present

# ------------------------------------------------------------------------------
# 12. Distributed 2-PC SSH Coordination (Only for PC Controller in 2-PC mode)
# ------------------------------------------------------------------------------
PEER_SSH_HOST=""
PEER_SSH_USER=""
PEER_PROJECT_ROOT=""
PEER_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5"

# ------------------------------------------------------------------------------
# 13. Optional DUT-side SSH & Hardware Acceleration Inspection
# ------------------------------------------------------------------------------
DUT_SSH_HOST=""
DUT_SSH_USER="root"
DUT_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5"
DUT_CAPTURE_IF="br0"
DUT_FLOWCACHE_STATUS_CMD="fcctl status"
