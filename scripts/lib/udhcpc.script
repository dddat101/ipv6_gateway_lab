#!/bin/sh
# udhcpc script for Network Namespaces (RFC 2132 compliant).
# Configures IP and default route inside netns without touching host /etc/resolv.conf.

case "${1:-}" in
    deconfig)
        ip -4 addr flush dev "${interface}" 2>/dev/null || true
        ;;
    renew|bound)
        ip -4 addr flush dev "${interface}" 2>/dev/null || true
        ip -4 addr add "${ip}/${mask:-24}" dev "${interface}" 2>/dev/null || true
        if [ -n "${router}" ]; then
            for r in ${router}; do
                ip -4 route replace default via "${r}" dev "${interface}" 2>/dev/null || true
                break
            done
        fi
        ;;
esac

exit 0
